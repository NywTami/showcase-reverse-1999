function updateBackground(data) {
  const badgeIcon = data.badges[0]?.icon;
  let element = "Star";
  if (badgeIcon?.includes("Plant")) element = "Plant";
  if (badgeIcon?.includes("Star")) element = "Star";
  if (badgeIcon?.includes("Beast")) element = "Beast";
  
  document.querySelector('.hero').style.setProperty('--bg-gradient', elementGradients[element] || elementGradients["Star"]);
  
  if (window.particleSystem && elementColors[element]) {
    particleSystem.updateElement(elementColors[element]);
  }
}

function renderData(data) {
  if (!data) return;

  charName.textContent = data.name;
  charQuote.innerHTML = data.quote;
  charImage.src = data.image;
  
  document.getElementById('roleName').textContent = characterRoles[data.name] || "Arcanist";
  document.getElementById('elementName').textContent = characterElement[data.name] || "Unknown";
  document.getElementById('weaponName').textContent = weaponNames[data.name] || "Standard Psychube";

  // Apply character-specific glow
  const glow = characterGlows[data.name] || "rgba(255,255,255,0.3)";
  charImage.style.filter = `drop-shadow(0 0 30px ${glow}) drop-shadow(0 0 60px ${glow.replace('0.3', '0.15')}) drop-shadow(0 0 100px ${glow.replace('0.3', '0.08')})`;

  charBadges.innerHTML = "";
  data.badges.forEach((badge) => {
    const wrapper = document.createElement("span");
    wrapper.className = "badge";
    const icon = document.createElement("img");
    icon.src = badge.icon;
    icon.alt = badge.text;
    const label = document.createElement("span");
    label.textContent = badge.text;
    wrapper.appendChild(icon);
    wrapper.appendChild(label);
    charBadges.appendChild(wrapper);
  });

  // Update character stats
  updateStats(data.name);

  updateBackground(data);
  replayFade([charImage, charName, charStars, charQuote, charBadges, document.getElementById('weaponDisplay'), document.getElementById('roleName'), document.getElementById('elementName')]);
}

function updateStats(characterName) {
  const stats = characterStats[characterName];
  if (!stats) return;

  // Animate values with count-up effect
  animateStat('stat-hp', stats.hp.value, stats.hp.max);
  animateStat('stat-atk', stats.atk.value, stats.atk.max);
  animateStat('stat-def', stats.def.value, stats.def.max);
  
  // Format crit & energy percentages
  document.getElementById('stat-crit').textContent = `${stats.crit.value}%`;
  document.getElementById('stat-energy').textContent = `${stats.energy.value}%`;

  // Animate progress bars
  setTimeout(() => {
    document.getElementById('stat-fill-hp').style.width = `${stats.hp.percent}%`;
    document.getElementById('stat-fill-atk').style.width = `${stats.atk.percent}%`;
    document.getElementById('stat-fill-def').style.width = `${stats.def.percent}%`;
    document.getElementById('stat-fill-crit').style.width = `${stats.crit.percent}%`;
    document.getElementById('stat-fill-energy').style.width = `${stats.energy.percent}%`;
  }, 200);
}

function animateStat(elementId, targetValue, maxValue) {
  const element = document.getElementById(elementId);
  if (!element) return;

  const duration = 800;
  const startTime = Date.now();
  const startValue = parseInt(element.textContent) || 0;
  const endValue = targetValue;

  function update() {
    const currentTime = Date.now();
    const elapsed = currentTime - startTime;
    const progress = Math.min(elapsed / duration, 1);
    
    const easeValue = progress < 0.5 
      ? 4 * progress * progress * progress 
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    const currentValue = Math.round(startValue + (endValue - startValue) * easeValue);
    element.textContent = currentValue;

    if (progress < 1) {
      requestAnimationFrame(update);
    }
  }

  requestAnimationFrame(update);
}

function updateTabImages(id) {
  tabButtons.forEach((btn) => {
    const category = btn.getAttribute("data-category");
    const img = btn.querySelector("img");
    const data = categories[category]?.[id];
    if (data?.tabimage) img.src = data.tabimage;
  });
}

function setActiveTab(category) {
  activeCategory = category;
  tabButtons.forEach((btn) => {
    btn.classList.toggle("active", btn.getAttribute("data-category") === category);
  });
}

function setActiveSkill(skillId) {
  activeSkill = skillId;
  skillButtons.forEach((btn) => {
    btn.classList.toggle("active", btn.getAttribute("data-skill") === skillId);
  });
}

function updateSkillTabs() {
  const skillSet = getCurrentSkillSet();
  skillButtons.forEach((btn) => {
    const skillId = btn.getAttribute("data-skill");
    const img = btn.querySelector("img");
    const skill = skillSet?.[skillId];
    if (skill?.icon) {
      img.src = skill.icon;
      img.hidden = false;
    } else {
      img.hidden = true;
    }
  });
}

function updateSkillPreview() {
  const skill = getCurrentSkill();
  const preview = skill?.preview;

  skillVideo.pause();
  skillVideo.removeAttribute("src");
  skillVideo.load();
  skillVideo.hidden = true;

  if (skillGif) {
    skillGif.removeAttribute("src");
    skillGif.hidden = true;
  }

  skillPreviewEmpty.hidden = true;

  if (!preview?.src) {
    skillPreviewEmpty.hidden = false;
    replayFade([skillPreviewEmpty]);
    return;
  }

  skillVideo.src = preview.src;
  skillVideo.hidden = false;
  skillVideo.loop = true;
  skillVideo.muted = true;
  skillVideo.autoplay = true;
  skillVideo.currentTime = 0;
  skillVideo.play().catch(() => {
  });
  
  document.getElementById('skillTitle').textContent = skill.name;
  document.getElementById('skillDesc').textContent = skill.desc;
  
  replayFade([skillVideo]);
}

function renderSkills() {
  updateSkillTabs();
  updateSkillPreview();
}

avatarItems.forEach((avatar) => {
  avatar.addEventListener("click", () => {
    const id = avatar.getAttribute("data-id");
    currentCharId = id;
    activeCategory = defaultCategory;
    activeSkill = defaultSkill;

    renderData(categories[defaultCategory]?.[id]);
    updateTabImages(id);
    setActiveTab(defaultCategory);
    setActiveSkill(defaultSkill);
    renderSkills();

    avatarItems.forEach((a) => a.classList.remove("active"));
    avatar.classList.add("active");
  });
});

tabButtons.forEach((btn) => {
  btn.addEventListener("click", () => {
    const category = btn.getAttribute("data-category");
    setActiveTab(category);
    activeSkill = defaultSkill;
    setActiveSkill(defaultSkill);
    renderData(categories[category]?.[currentCharId]);
    renderSkills();
  });
});

skillButtons.forEach((btn) => {
  btn.addEventListener("click", () => {
    const skillId = btn.getAttribute("data-skill");
    setActiveSkill(skillId);
    updateSkillPreview();
  });
});

updateTabImages(currentCharId);
renderData(categories[defaultCategory][currentCharId]);
setActiveTab(defaultCategory);
setActiveSkill(defaultSkill);
renderSkills();

const navItems = document.querySelectorAll(".nav-item");

navItems.forEach((item) => {
  item.addEventListener("click", () => {
    navItems.forEach((el) => el.classList.remove("active"));
    item.classList.add("active");
  });
});

class ParticleSystem {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.particles = [];
    this.maxParticles = 80;
    this.colors = {
      Plant: ['#4ade80', '#22c55e', '#86efac'],
      Star: ['#a78bfa', '#8b5cf6', '#c4b5fd'],
      Beast: ['#fb923c', '#f97316', '#fdba74']
    };
    this.currentElement = 'Star';
    this.resize();
    this.init();
    this.animate();
    window.addEventListener('resize', () => this.resize());
  }

  resize() {
    this.canvas.width = this.canvas.offsetWidth;
    this.canvas.height = this.canvas.offsetHeight;
  }

  init() {
    for (let i = 0; i < this.maxParticles; i++) {
      this.particles.push(this.createParticle());
    }
  }

  createParticle() {
    const colors = this.colors[this.currentElement];
    return {
      x: Math.random() * this.canvas.width,
      y: Math.random() * this.canvas.height,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      radius: Math.random() * 2 + 1,
      color: colors[Math.floor(Math.random() * colors.length)],
      opacity: Math.random() * 0.5 + 0.2
    };
  }

  updateElement(element) {
    this.currentElement = element;
    this.particles.forEach(p => {
      const colors = this.colors[element];
      p.color = colors[Math.floor(Math.random() * colors.length)];
    });
  }

  update() {
    this.particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;

      if (p.x < 0 || p.x > this.canvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > this.canvas.height) p.vy *= -1;
    });
  }

  draw() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    
    this.particles.forEach(p => {
      this.ctx.beginPath();
      this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      this.ctx.fillStyle = p.color;
      this.ctx.globalAlpha = p.opacity;
      this.ctx.fill();
      
      const gradient = this.ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius * 3);
      gradient.addColorStop(0, p.color);
      gradient.addColorStop(1, 'transparent');
      this.ctx.fillStyle = gradient;
      this.ctx.globalAlpha = p.opacity * 0.3;
      this.ctx.fillRect(p.x - p.radius * 3, p.y - p.radius * 3, p.radius * 6, p.radius * 6);
    });
    
    this.ctx.globalAlpha = 1;
  }

  animate() {
    this.update();
    this.draw();
    requestAnimationFrame(() => this.animate());
  }
}

// 3D Tilt Effect on Hero Image
const heroImageContainer = document.querySelector('.hero-image-container');
const heroImage = document.getElementById('charImage');

if (heroImageContainer && heroImage) {
  heroImageContainer.addEventListener('mousemove', (e) => {
    const rect = heroImageContainer.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    const centerX = rect.width / 2;
    const centerY = rect.height / 2;
    
    const rotateX = ((y - centerY) / centerY) * -10;
    const rotateY = ((x - centerX) / centerX) * 10;
    
    heroImage.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
    heroImage.style.transition = 'transform 0.05s linear';
  });

  heroImageContainer.addEventListener('mouseleave', () => {
    heroImage.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    heroImage.style.transition = 'transform 0.5s ease-out';
  });
}

const skillModal = document.getElementById('skillModal');
const modalVideo = document.getElementById('modalVideo');
const modalTitle = document.getElementById('modalTitle');
const modalDesc = document.getElementById('modalDesc');
const modalClose = document.getElementById('modalClose');
const skillPreviewContainer = document.getElementById('skillPreview');

skillPreviewContainer.addEventListener('click', () => {
  const skill = getCurrentSkill();
  if (!skill?.preview?.src) return;
  
  modalVideo.src = skill.preview.src;
  modalTitle.textContent = skill.name;
  modalDesc.textContent = skill.desc;
  skillModal.classList.add('active');
  modalVideo.currentTime = 0;
  modalVideo.play();
});

modalClose.addEventListener('click', () => {
  skillModal.classList.remove('active');
  modalVideo.pause();
  modalVideo.src = '';
});

skillModal.addEventListener('click', (e) => {
  if (e.target === skillModal) {
    skillModal.classList.remove('active');
    modalVideo.pause();
    modalVideo.src = '';
  }
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && skillModal.classList.contains('active')) {
    skillModal.classList.remove('active');
    modalVideo.pause();
    modalVideo.src = '';
  }
});

const avatarsContainer = document.querySelector('.hero-avatars');
const prevBtn = document.querySelector('.carousel-nav.prev');
const nextBtn = document.querySelector('.carousel-nav.next');

if (avatarsContainer && prevBtn && nextBtn) {
  const scrollAmount = 230; 

  function updateButtonVisibility() {
    const { scrollLeft, scrollWidth, clientWidth } = avatarsContainer;
    
    if (scrollLeft <= 5) {
      prevBtn.disabled = true;
    } else {
      prevBtn.disabled = false;
    }
    
    // Hide next button at end
    if (scrollLeft + clientWidth >= scrollWidth - 5) {
      nextBtn.disabled = true;
    } else {
      nextBtn.disabled = false;
    }
  }

  // Initial check
  updateButtonVisibility();

  // Update on scroll
  avatarsContainer.addEventListener('scroll', updateButtonVisibility);

  prevBtn.addEventListener('click', () => {
    avatarsContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  nextBtn.addEventListener('click', () => {
    avatarsContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });

  // Enable Mouse Drag Scrolling
  let isDown = false;
  let startX;
  let scrollLeft;

  avatarsContainer.addEventListener('mousedown', (e) => {
    isDown = true;
    avatarsContainer.style.cursor = 'grabbing';
    startX = e.pageX - avatarsContainer.offsetLeft;
    scrollLeft = avatarsContainer.scrollLeft;
  });

  avatarsContainer.addEventListener('mouseleave', () => {
    isDown = false;
    avatarsContainer.style.cursor = 'default';
  });

  avatarsContainer.addEventListener('mouseup', () => {
    isDown = false;
    avatarsContainer.style.cursor = 'default';
  });

  avatarsContainer.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - avatarsContainer.offsetLeft;
    const walk = (x - startX) * 2;
    avatarsContainer.scrollLeft = scrollLeft - walk;
  });
}