const charBadges = document.getElementById("charBadges");
const charQuote = document.getElementById("charQuote");
const charImage = document.getElementById("charImage");
const charStars = document.getElementById("charStars");

const skillGif = document.getElementById("skillGif");
const skillVideo = document.getElementById("skillVideo");
const skillPreviewEmpty = document.getElementById("skillPreviewEmpty");

const getCurrentSkillSet = () => skillData[currentCharId]?.[activeCategory];
const getCurrentSkill = () => getCurrentSkillSet()?.[activeSkill];

function replayFade(elements) {
  elements.forEach((el) => {
    if (!el) return;
    el.classList.remove("fade-in");
    void el.offsetWidth;
    el.classList.add("fade-in");
  });
}

